# Использование Node.js 22
FROM node:22-alpine

# Задаётся рабочая директория в контейнере
WORKDIR /app

# Копируются package.json и package-lock.json
COPY package*.json ./

# Установка зависимостей
RUN npm ci

# Копирование всех файлов из локального каталога в контейнер
COPY . .

# Открывает порт 3000 в контейнере
EXPOSE 3000

# Сообщает Docker о необходимости запуска npm start при запуске контейнера.
# Скрипт start поднимает Vite на 0.0.0.0:3000, иначе сервер внутри контейнера
# слушал бы только localhost и был бы недоступен снаружи.
CMD ["npm", "start"]
